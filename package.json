{
  "name": "google-form-lite",
  "version": "1.0.0",
  "private": "true",
  "description": "A full-stack Google Forms clone build as a monorepo.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start:client": "npm run dev --workspace=client",
    "start:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run start:client\" \"npm run start:server\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:server && npm run build client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}